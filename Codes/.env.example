# ============================================================
# HyperloopBert Research Pipeline
# Environment Variable Template — NEVER commit the real .env file to version control
# Copy this file to .env and fill in the real values before running any script.
# ============================================================

# ---- HuggingFace (datasets + model hub) ----
# Also accepted as alias: HF_TOKEN or HUGGINGFACE_TOKEN
HF_KEY=

# ---- Google AI Studio / Gemini : PRIMARY judge and extraction, round-robin over 4 keys ----
# Also accepted as: GEMINI_API_KEY_1, GEMINI_API_KEY_2, GEMINI_API_KEY_3, GEMINI_API_KEY_4
GCP_KEY1=
GCP_KEY2=
GCP_KEY3=
GCP_KEY4=

# ---- DeepSeek : SECONDARY, round-robin over 2 keys ----
# Also accepted as: DEEPSEEK_API_KEY_1, DEEPSEEK_API_KEY_2
DEEPSEEK_KEY1=
DEEPSEEK_KEY2=
# Optional: override base URL (default: https://api.deepseek.com/v1)
DEEPSEEK_API_BASE_URL=

# ---- Mistral : TERTIARY, round-robin over 2 keys ----
# Also accepted as: MISTRAL_API_KEY1, Mistral_API_KEY2
MISTRAL_KEY1=
MISTRAL_KEY2=

# ---- OpenRouter : alternate router, round-robin over 2 keys ----
# Also accepted as: OPENROUTER_API_KEY_1, OPENROUTER_API_KEY_2
OPENROUTER_KEY1=
OPENROUTER_KEY2=
# Optional: override base URL (default: https://openrouter.ai/api/v1)
OPENROUTER_API_BASE_URL=

# ---- Optional ----
OPENAI_API_KEY=

# ---- Experiment ----
# Random seed for reproducibility (overridden by --seeds flag)
RANDOM_SEED=42
